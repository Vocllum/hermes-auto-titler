# Hermes auto-titler 配置
enabled: true
every_n_turns: 4
on_close: true
early_turn_eval: false  # 旧开关（保留兼容）：first_title_mode=plugin 时等价 true；builtin 时强制失效
first_title_mode: builtin  # 首轮命名一键开关：builtin=首轮归内建（插件不抢，省一次全上下文调用）；plugin=插件第1轮就接管全上下文命名并自动关闭宿主标题器
recent_turns: 2
opening_turns: 2
ignore_model_messages: false
preview_chars: 400
include_all_user_messages: true
user_message_threshold: 40
user_message_preview_chars: 300
summary_preview_chars: 1200      # 压缩摘要进标题评估的截断长度（日常评估；盲改用 retitle_summary_chars）
retitle_summary_chars: 12000     # 仅 retitle-all 全量重命名（盲改）：压缩摘要截断长度（0=沿用 preview_chars）
title_style: concise  # concise = LABEL：主体标签（Subject + 最小区分意图）；complete = SUMMARY：简短事件梗概（Subject + 主要意图/事件）。信息类型是第一约束，长度只是护栏
strategy: conservative
# 留空并通过 Hermes 的内建 title_generation 辅助任务路由；
# 插件运行时会优先使用 auxiliary.title_generation 的 provider/model。
provider: ""
model: ""
min_interval_minutes: 5
max_title_length: 24
max_display_width: 40
rename_confirmations: 0  # 评审协议：0=关闭（单轮直接写库）；1=确认1次（第1轮挂起pending，第2轮模型觉得上一轮改名可以则approve落库）
renames_per_hour: 0      # 单会话每小时实际改名上限（滑动窗口）；0=不限
